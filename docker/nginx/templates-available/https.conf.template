# SSL_ENABLED=true 时使用:443 终结 TLS
# 证书由 compose 挂载:
#   ./docker/<env>/ssl/fullchain.pem -> /etc/nginx/ssl/fullchain.pem
#   ./docker/<env>/ssl/privkey.pem   -> /etc/nginx/ssl/privkey.pem
server {
    listen      443 ssl;
    listen      [::]:443 ssl;
    http2       on;
    server_name ${SERVER_NAME};

    ssl_certificate     /etc/nginx/ssl/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/privkey.pem;

    ssl_session_timeout 1d;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_tickets off;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    error_page 497 =301 https://$http_host$request_uri;

    # HSTS_HEADER 默认 "max-age=31536000";local-https 置空,避免自签证书被信任后 Chrome 对 localhost 所有端口强制 https
    add_header Strict-Transport-Security "${HSTS_HEADER}" always;

    include /etc/nginx/snippets/app-locations.conf;
}
