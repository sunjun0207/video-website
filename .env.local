# ===== 本地开发 =====
# npm run dev 使用默认 mode，只额外加载本文件。

VITE_APP_ENV=local
VITE_APP_TITLE=观影 jun.sun
VITE_BASE=/
VITE_SOURCEMAP=true
VITE_DEV_PORT=5175

# true 封面和播放也走本站代理。false 时封面和播放直连片源。片库页面始终走 /vod。
VITE_USE_PROXY=false

# *_TARGET 是片源地址。片库页面始终由开发代理或 nginx 的 /vod 转发。封面和播放仅在开关为 true 时转发。
VITE_VOD_TARGET=https://www.dushe05.com
VITE_IMG_TARGET=https://vres.wkcyvs.cn
VITE_IMG_A_TARGET=https://103.39.111.180:51050
VITE_IMG_B_TARGET=https://103.39.111.184:51050

# 片库备用域名，逗号分隔。只有 nginx 用：片库回 404 / 5xx 或连不上时依次改走这些地址。
VITE_VOD_BACKUP_TARGETS=https://www.dushe06.com,https://www.dushe07.com
